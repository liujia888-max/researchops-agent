# 环境变量模板。复制为 .env 后填入真实值，.env 不入库。
# LLM Provider 三选一（详见 src/researchops/llm/providers.py）

# DeepSeek 云 API（默认主力）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 通义 Qwen 云 API（备选）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# vLLM 自部署（OpenAI 兼容协议，私有化演示用，跑在远程 5090）
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=not-needed

# 默认用哪个 provider：deepseek | qwen | vllm
LLM_PROVIDER=deepseek

# Phase 1 — RAG：embedding 服务与向量库
# bge-m3 + reranker 推理服务（scripts/inference_server.py 起在 GPU/CPU 主机）
INFERENCE_BASE_URL=http://127.0.0.1:8001
# 推理服务不可达时，退化为零依赖的 feature-hash 嵌入（词法检索），保证无 GPU 也能跑通
RAG_FALLBACK_LOCAL=true
# Qdrant 向量库（docker compose 内会自动覆盖为 http://qdrant:6333）
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=papers
# 混合检索：RRF 融合前各分支候选数 / rerank 后返回条数
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_K=5

# Phase 2 — labops MCP server：SSH 到远程 GPU 主机做实验编排
LABOPS_HOST=connect.westd.seetacloud.com
LABOPS_PORT=22050
LABOPS_USER=root
LABOPS_KEY_PATH=~/.ssh/id_rsa
LABOPS_WORKDIR=/root/autodl-tmp
LABOPS_COMMAND_TIMEOUT=30.0

# 成本估算与预算上限（USD / 1M tokens；默认 deepseek-chat 现价）
LLM_INPUT_PRICE_PER_1M=0.14
LLM_OUTPUT_PRICE_PER_1M=0.28
# 单次 agent 运行的硬性成本上限（0 = 不限制；公开部署建议设一个，如 0.5）
AGENT_MAX_COST_USD=0.0

# Phase 3 — Langfuse 云可观测（留空则禁用导出，--trace 本地摘要仍可用）
# base_url 按注册区域选：cloud.langfuse.com(欧盟) / us.cloud.langfuse.com(美国) / cloud.langfuse.cn(中国)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
